         {
+          __structuredAttrs = true;
+          strictDeps = true;
           nativeBuildInputs = [ pkgs.pkgconf ];
           buildInputs = [ dep ];
+          outputChecks.out.disallowedRequisites = [ pkgs.pkgconf ];
         }
         ''
           mkdir -p "$out/lib/pkgconfig"
-          for pc in $(pkgconf --list-package-names); do
