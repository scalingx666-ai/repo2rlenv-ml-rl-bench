diff --git a/build/lib/tsec.ts b/build/lib/tsec.ts
new file mode 100644
index 0000000000000..af5c6dec784d3
--- /dev/null
+++ b/build/lib/tsec.ts
@@ -0,0 +1,38 @@
+/*---------------------------------------------------------------------------------------------
