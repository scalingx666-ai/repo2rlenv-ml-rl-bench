+def _not_equal_nulls_equal(left, right):
+    # Like pc.not_equal, but two nulls are equal and a null differs from any non-null value.
+    # pc.not_equal returns null in both cases, and has no kernel for the null type.
+    nulls_differ = pc.xor(pc.is_null(left), pc.is_null(right))
+    if pa.types.is_null(left.type) or pa.types.is_null(right.type):
+        return nulls_differ
+    return pc.or_(pc.fill_null(pc.not_equal(left, right), False), nulls_differ)
+
+
