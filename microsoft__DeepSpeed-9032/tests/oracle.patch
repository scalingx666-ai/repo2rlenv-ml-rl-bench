diff --git a/.github/workflows/cpu-torch-latest-v1-multirank.yml b/.github/workflows/cpu-torch-latest-v1-multirank.yml
index 5dec2a827c75..36c4d71f2d05 100644
--- a/.github/workflows/cpu-torch-latest-v1-multirank.yml
+++ b/.github/workflows/cpu-torch-latest-v1-multirank.yml
@@ -278,6 +278,8 @@ jobs:
           HF_HUB_DISABLE_XET=1 HF_HOME=/tmp/hf_home hf download bert-base-uncased
 
       - name: Unit tests
+        env:
+          SELECTION_MODE: ${{ needs.collect-tests.outputs.mode }}
         run: |
           unset TORCH_CUDA_ARCH_LIST # only jit compile for current arch
           cd tests
@@ -287,7 +289,19 @@ jobs:
             exit 0
           fi
           echo "Selected targets (${#targets[@]}): ${targets[*]}"
+          set +e
           HF_HOME=/tmp/hf_home \
             LOCAL_SIZE=4 \
             DS_MULTIRANK_ONLY=1 \
             pytest $PYTEST_OPTS --forked -n 4 "${targets[@]}" --torch_ver="$TORCH_TEST_VERSION"
+          pytest_exit=$?
+          set -e
+          # Only a subset selection can legitimately hold no multi-rank tests:
+          # DS_MULTIRANK_ONLY deselects the single-rank ones and pytest exits 5
+          # for "no tests ran". In mode=all the whole v1 scope is selected, so
+          # an empty run means the selector or the multi-rank gate broke.
+          if [ "$pytest_exit" -eq 5 ] && [ "$SELECTION_MODE" = "subset" ]; then
+            echo "No multi-rank tests in the selection; nothing to run."
+            exit 0
+          fi
+          exit "$pytest_exit"
