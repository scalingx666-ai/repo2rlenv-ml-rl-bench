+
+  describe('hooks in streamed values', () => {
+    async function render(model, options) {
+      const {writable, readable} = getTestStream();
+      const {pipe} = await serverAct(() =>
+        ReactServerDOMServer.renderToPipeableStream(model, webpackMap, {
